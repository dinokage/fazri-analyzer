###############################################################################
# FAZRI — Production Environment Variables
#
# Copy to .env.prod and fill in ALL values before running:
#   cp .env.prod.example .env.prod
#
# NEVER commit .env.prod to version control.
# Required fields are marked with [REQUIRED].
###############################################################################

# ─── PostgreSQL (main DB) ─────────────────────────────────────────────────────
POSTGRES_USER=fazri                          # [REQUIRED] DB superuser name
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD  # [REQUIRED] Use a long random string
POSTGRES_DB=fazri_prod                       # [REQUIRED] Database name

# ─── pgvector (DeepFace embeddings) ──────────────────────────────────────────
DEEPFACE_POSTGRES_USER=deepface
DEEPFACE_POSTGRES_PASSWORD=CHANGE_ME_DEEPFACE_PASSWORD  # [REQUIRED]
DEEPFACE_POSTGRES_DB=deepface

# ─── Neo4j (movement graph) ───────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD  # [REQUIRED] Min 8 chars

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXTAUTH_URL=https://fazri.yourcampus.edu     # [REQUIRED] Your public domain
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET     # [REQUIRED] openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET  # [REQUIRED] Must match auth service

# Public URL the browser uses to reach the backend API.
# If nginx proxies /api → backend this can stay as-is.
NEXT_PUBLIC_FASTAPI_BASE_URL=https://fazri.yourcampus.edu

# ─── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_FASTAPI_SECRET_KEY  # [REQUIRED] openssl rand -hex 32

# Auth service JWT validation
AUTH_SERVICE_URL=https://auth.yourcampus.edu  # [REQUIRED] better-auth deployment URL
AUTH_DATABASE_URL=                            # Optional: direct PG connection to auth DB

# ─── DeepFace ─────────────────────────────────────────────────────────────────
DEEPFACE_ENABLED=true
DEEPFACE_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET  # [REQUIRED] openssl rand -hex 32
DEEPFACE_CONFIDENCE_THRESHOLD=0.40
DEEPFACE_LOW_CONFIDENCE_DISTANCE=0.35
DEEPFACE_IMPOSSIBLE_TRAVEL_MINUTES=5
DEEPFACE_BATCH_SYNC_INTERVAL_SECONDS=300

# ─── go2rtc ───────────────────────────────────────────────────────────────────
GO2RTC_ENABLED=true
# go2rtc.yaml mounts at ./go2rtc.yaml — add camera streams there

# ─── Hikvision RFID access control ───────────────────────────────────────────
HIKVISION_ENABLED=false                      # Set true after configuring
HIKVISION_BASE_URL=http://192.168.1.100      # [REQUIRED if enabled] NVR IP
HIKVISION_USERNAME=admin                     # [REQUIRED if enabled]
HIKVISION_PASSWORD=CHANGE_ME_HIKVISION_PW    # [REQUIRED if enabled]
HIKVISION_POLL_INTERVAL_SECONDS=5
# Map door reader IDs → zone_ids (JSON). Add one entry per door.
# Example: door 1 = library entrance, door 2 = lab 101
HIKVISION_DOOR_ZONE_MAP={"1":"LIB_ENT","2":"LAB_101"}

# ─── Aruba WiFi controller ────────────────────────────────────────────────────
ARUBA_ENABLED=false                          # Set true after configuring
ARUBA_BASE_URL=http://192.168.1.200          # [REQUIRED if enabled] Controller IP
ARUBA_USERNAME=admin                         # [REQUIRED if enabled]
ARUBA_PASSWORD=CHANGE_ME_ARUBA_PW            # [REQUIRED if enabled]
ARUBA_POLL_INTERVAL_SECONDS=30
# Map AP names → zone_ids (JSON). Add one entry per AP.
# Example: library AP → LIB_ENT, lab AP → LAB_101
ARUBA_AP_ZONE_MAP={"AP-LIB-1F-01":"LIB_ENT","AP-LAB-2F-01":"LAB_101"}

# ─── Alert system ─────────────────────────────────────────────────────────────
ALERT_SYSTEM_ENABLED=true
ALERT_COOLDOWN_SECONDS=60

# ─── Notifications ────────────────────────────────────────────────────────────
NOTIFICATION_MOCK_MODE=false   # Set false to send real notifications
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcampus.edu             # [REQUIRED if email enabled]
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD       # [REQUIRED if email enabled]
EMAIL_FROM_ADDRESS=alerts@yourcampus.edu

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Sentry (optional error tracking) ────────────────────────────────────────
SENTRY_ENABLED=false
SENTRY_DSN=                     # Get from sentry.io — add if using Sentry
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05  # 5% in production

# ─── GitLab integration (optional) ───────────────────────────────────────────
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=                   # Personal access token with read_api scope
GITLAB_PROJECT_ID=              # numeric ID or "namespace/repo"

# ─── AI Chatbot (optional) ────────────────────────────────────────────────────
CHATBOT_ENABLED=true
GOOGLE_API_KEY=                 # Google AI Studio API key, or leave blank for Vertex AI
USE_VERTEX_AI=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# ─── Discord alert webhook (optional) ────────────────────────────────────────
DISCORD_WEBHOOK_URL=            # Paste Discord incoming webhook URL or leave blank
