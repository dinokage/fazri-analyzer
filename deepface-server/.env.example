# Copy this file to .env and fill in values before running.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1               # keep at 1; DeepFace model cache is not multiprocess-safe

# ── DeepFace ML config ────────────────────────────────────────────────────────
MODEL_NAME=Buffalo_L
DETECTOR_BACKEND=mtcnn
DISTANCE_METRIC=cosine
COSINE_THRESHOLD=0.55
ENFORCE_DETECTION=true

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
# Read by this app AND by DeepFace's internal DB client
DEEPFACE_POSTGRES_URI=postgresql://deepface:deepface@localhost:5432/deepface
DEEPFACE_DATABASE_TYPE=postgres
