# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/auth/node_modules
/auth/dist
/docs/*
!docs/enrollment-runbook.md
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.prod.example

# vercel
.vercel
clau-docs/
# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/backend/backup*
/backend/anal/*

# git worktrees
.worktrees/

# Sentry
.sentryclirc
.sentry-*
sentry-debug-files/

# ML model artifacts
*.pkl
*.pickle
*.h5
*.pt
*.onnx

# Large data files
*.csv.gz

# Synthetic / augmented data (large CSVs, not for version control)
backend/augmented/

# Credentials (belt-and-suspenders)
*credentials*.json
!*credentials*.json.example