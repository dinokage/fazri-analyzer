# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/web/node_modules
/apps/auth/node_modules
/apps/auth/dist
/packages/ui/node_modules
/packages/types/node_modules
/packages/config/node_modules
/docs/*
!docs/enrollment-runbook.md
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/apps/web/.next/
/apps/web/out/

# production
/build
/apps/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.prod.example

# vercel
.vercel
clau-docs/
# typescript
*.tsbuildinfo
next-env.d.ts

/apps/web/src/generated/prisma
/apps/auth/prisma/generated/
/apps/api/backup*
/apps/api/anal/*

# git worktrees
.worktrees/

# Sentry
.sentryclirc
.sentry-*
sentry-debug-files/

# ML model artifacts
*.pkl
*.pickle
*.h5
*.pt
*.onnx

# Large data files
*.csv.gz

# Synthetic / augmented data (large CSVs, not for version control)
apps/api/augmented/

# Credentials (belt-and-suspenders)
*credentials*.json
!*credentials*.json.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.egg
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db

# Docker / misc logs
*.log

# Local mediamtx config file
apps/api/mediamtx.yml
