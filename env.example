NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/mydb?schema=public
NEXT_PUBLIC_FASTAPI_BASE_URL=https://docs.dinokage.in
NEXT_PUBLIC_CDN_URL=https://cdn.hextasphere.com/ethos

# ─── DeepFace Integration ────────────────────────────────────────────────────
# URL of the DeepFace server (container-to-container name in docker-compose)
DEEPFACE_SERVER_URL=http://deepface-server:8000
# HMAC-SHA256 secret for webhook signature validation (X-DeepFace-Signature header)
# Leave empty in local dev; always set a strong secret in staging/production
DEEPFACE_WEBHOOK_SECRET=
# Face distance threshold — matches below this are accepted (0.40 = ArcFace default)
DEEPFACE_CONFIDENCE_THRESHOLD=0.40
# Distance above which a match is flagged as "low confidence" even if within threshold
DEEPFACE_LOW_CONFIDENCE_DISTANCE=0.35
# Minutes threshold for impossible-travel anomaly detection
DEEPFACE_IMPOSSIBLE_TRAVEL_MINUTES=5
# Batch sync interval in seconds (0 = disabled)
DEEPFACE_BATCH_SYNC_INTERVAL_SECONDS=300
# Connection string to the DeepFace pgvector Postgres DB (for batch sync)
DEEPFACE_POSTGRES_URI=postgresql://deepface:deepface@deepface-postgres:5432/deepface
# Set to false to disable all DeepFace routes and background tasks
DEEPFACE_ENABLED=true