# FastAPI Application Environment Variables
# Copy this file to .env and fill in your actual values

# Neo4j Configuration
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# PostgreSQL Configuration
POSTGRES_SERVER=postgres_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=ethos_iitg
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Application Settings
DEBUG=false
TESTING=false
LOG_LEVEL=INFO
SECRET_KEY=<generate-random-secret-key>
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT Configuration (NextAuth Integration)
# IMPORTANT: This MUST match the NEXTAUTH_SECRET in your frontend .env
NEXTAUTH_SECRET=<copy-from-frontend-env>
JWT_ALGORITHM=HS256

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost

# File Paths
DATA_DIR=/app/augmented
MODELS_DIR=/app/models
LOGS_DIR=/app/logs

# ML/AI Configuration
ML_MODEL_CACHE_SIZE=10
PREDICTION_BATCH_SIZE=32

# Anomaly Detection
ANOMALY_DETECTION_ENABLED=true
ANOMALY_CACHE_TTL_SECONDS=300

# Live Data Pipeline
LIVE_DATA_PIPELINE_ENABLED=true

# Database Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# PgAdmin Configuration (for management interface)
PGADMIN_EMAIL=admin@fazri.com
PGADMIN_PASSWORD=<your-pgadmin-password>

# Chatbot Configuration (Gemini / Vertex AI)
# For Google AI Studio (free tier limited):
GOOGLE_API_KEY=<your-google-api-key>

# For Vertex AI (uses Google Cloud billing):
USE_VERTEX_AI=true
VERTEX_PROJECT_ID=<your-gcp-project-id>
VERTEX_LOCATION=us-central1

# Model to use (works with both backends)
CHATBOT_MODEL=gemini-2.0-flash

# GitHub Integration
GITHUB_TOKEN=<your-github-token>
GITHUB_REPOSITORY=<owner/repo>

# Sentry Configuration
SENTRY_DSN=<your-sentry-backend-dsn>
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENABLED=false
