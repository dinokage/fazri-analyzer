# FastAPI Application Environment Variables
# Copy this file to .env and fill in your actual values
# ⚠️  NEVER commit .env to git!

# Neo4j Configuration
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL Configuration
POSTGRES_SERVER=postgres_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ethos_iitg
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Application Settings
DEBUG=false
TESTING=false
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# File Paths
DATA_DIR=/app/augmented
MODELS_DIR=/app/models
LOGS_DIR=/app/logs

# ML/AI Configuration
ML_MODEL_CACHE_SIZE=10
PREDICTION_BATCH_SIZE=32

# Anomaly Detection
ANOMALY_DETECTION_ENABLED=true
ANOMALY_CACHE_TTL_SECONDS=300

# Live Data Pipeline
LIVE_DATA_PIPELINE_ENABLED=true

# Database Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# PgAdmin Configuration (for management interface)
PGADMIN_EMAIL=admin@fazri.com
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Chatbot Configuration (Gemini / Vertex AI)
# For Google AI Studio (free tier limited):
GOOGLE_API_KEY=CHANGE_ME_GET_FROM_GOOGLE_AI_STUDIO

# For Vertex AI (uses Google Cloud billing):
USE_VERTEX_AI=false
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Model to use (works with both backends)
CHATBOT_MODEL=gemini-2.0-flash

# GitLab Integration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=CHANGE_ME_GET_FROM_GITLAB_SETTINGS
GITLAB_PROJECT_ID=your-username/your-repo
